{
  "name": "wichtelweg-inkottem",
  "version": "1.2.0",
  "description": "Vereinsportal fuer den Wichtelweg Kottenheim e.V.",
  "main": "main.js",
  "author": "WichtelGroup Software Division",
  "license": "COMMERCIAL",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "de.inkottem.wichtelweg",
    "npmRebuild": true,
    "productName": "Wichtelweg Kottenheim",
    "files": [
      "main.js",
      "database.js",
      "index.html",
      "license.html",
      "icon.ico",
      "LICENSE.txt",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wichtelweg #inKottem",
      "license": "LICENSE.txt",
      "language": "1031",
      "warningsAsErrors": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  }
}
